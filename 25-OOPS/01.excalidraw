      "version": 251,
      "versionNonce": 1328760,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785171024386,
      "link": null,
      "locked": false,
      "text": "class <class_Name> {\n\n    <access_modifier> <data_type> <variable_name>=<value>?;\n    <access_modifier> <data_type> <variable_name>=<value>?;\n    <access_modifier> <data_type> <variable_name>=<value>?;\n    ....\n    ....\n\n    <access_modifier><return_type> <class_name> (<arg_list>) \n    {\n    \n\n    }\n    ......\n    ....\n\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class <class_Name> {\n\n    <access_modifier> <data_type> <variable_name>=<value>?;\n    <access_modifier> <data_type> <variable_name>=<value>?;\n    <access_modifier> <data_type> <variable_name>=<value>?;\n    ....\n    ....\n\n    <access_modifier><return_type> <class_name> (<arg_list>) \n    {\n    \n\n    }\n    ......\n    ....\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
