      "updated": 1782372711920,
      "link": null,
      "locked": false,
      "text": "Two elements of Objects are\n--------------------------------------\n\n1.Property (data)\n2. behaviour (methods)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Two elements of Objects are\n--------------------------------------\n\n1.Property (data)\n2. behaviour (methods)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Dnogrj4ZuSdUIBgp_kgs7",
      "type": "text",
      "x": 318,
      "y": 631,
      "width": 492,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
