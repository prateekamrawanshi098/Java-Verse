      "boundElements": null,
      "updated": 1785215246656,
      "link": null,
      "locked": false,
      "text": "class Student1 {\n    private int roll;\n    private char grade;\n    private double per;\n\n    public void setStudent() {\n        roll = 10;\n        grade   = 'A';\n        per=78.9;\n    }\n\n    public void showStudent() {\n    System.out.println(\"Roll = \"+roll+\"\\ngarde = \"+grade+\"\\nper = \"+per);\n    }\n}\n\nclass UseStudent1 {\n    public static void main(String[] args) {\n        Student1 s = new Student1();\n        s.setStudent();\n        s.showStudent();\n    }\n}\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Student1 {\n    private int roll;\n    private char grade;\n    private double per;\n\n    public void setStudent() {\n        roll = 10;\n        grade   = 'A';\n        per=78.9;\n    }\n\n    public void showStudent() {\n    System.out.println(\"Roll = \"+roll+\"\\ngarde = \"+grade+\"\\nper = \"+per);\n    }\n}\n\nclass UseStudent1 {\n    public static void main(String[] args) {\n        Student1 s = new Student1();\n        s.setStudent();\n        s.showStudent();\n    }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
