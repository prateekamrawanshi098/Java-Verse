      "updated": 1785215100178,
      "link": null,
      "locked": false,
      "text": "class Student {\n    int roll;\n    char grade;\n    double per;\n}\n\nclass UseStudent {\n    public static void main(String[] args) {\n        Student s = new Student();\n        s.roll = 10;\n        s.grade = 'A';\n        s.per = 79.4;\n        System.out.println(\"Roll = \"+s.roll+\" \\nGrade = \"+s.grade+\" \\nPercentage = \"+s.per);\n    }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Student {\n    int roll;\n    char grade;\n    double per;\n}\n\nclass UseStudent {\n    public static void main(String[] args) {\n        Student s = new Student();\n        s.roll = 10;\n        s.grade = 'A';\n        s.per = 79.4;\n        System.out.println(\"Roll = \"+s.roll+\" \\nGrade = \"+s.grade+\" \\nPercentage = \"+s.per);\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
