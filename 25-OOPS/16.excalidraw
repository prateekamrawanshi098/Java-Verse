          "type": "arrow"
        }
      ],
      "updated": 1785423041325,
      "link": null,
      "locked": false,
      "text": "A reference (address)\nof the original object\nis passed to the\nmethod. Changes\nmade through the\nreference affect the\noriginal object.",
      "fontSize": 19.657785111157843,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A reference (address) of the original object is passed to the method. Changes made through the reference affect the original object.",
      "autoResize": false,
      "lineHeight": 1.25
    },
