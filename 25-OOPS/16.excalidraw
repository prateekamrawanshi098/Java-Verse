        }
      ],
      "updated": 1785423041325,
      "link": null,
      "locked": false,
      "text": "A copy of the\nvariable's value\nis passed to\nthe method.\nChanges inside\nthe method do\nnot affect the\noriginal variable.",
      "fontSize": 19.657785111157843,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A copy of the variable's value is passed to the method. Changes inside the method do not affect the original variable.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "uR2HebjkDJXGzBls8x94B",
      "type": "text",
