      "link": null,
      "locked": false,
      "text": "import java.util.Scanner;\n\nclass Math2 {\n    public int sumArray(int[] brr) {\n        int total = 0;\n        for (int x : brr) {\n            total += x;\n        }\n        return total;\n    }\n}\n\n\nclass UseMath2 {\n    public static void main(String[] args) {\n        Scanner kb = new Scanner(System.in);\n        int[] arr=new int[5];\n        for (int i = 0; i < arr.length; i++) {\n            System.out.println(\"Enter a number\");\n            arr[i] = kb.nextInt();\n        }\n        Math2 obj = new Math2();\n        int result =obj.sumArray(arr);\n        System.out.println(\"Sum of Array elements are \"+result);\n    }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import java.util.Scanner;\n\nclass Math2 {\n    public int sumArray(int[] brr) {\n        int total = 0;\n        for (int x : brr) {\n            total += x;\n        }\n        return total;\n    }\n}\n\n\nclass UseMath2 {\n    public static void main(String[] args) {\n        Scanner kb = new Scanner(System.in);\n        int[] arr=new int[5];\n        for (int i = 0; i < arr.length; i++) {\n            System.out.println(\"Enter a number\");\n            arr[i] = kb.nextInt();\n        }\n        Math2 obj = new Math2();\n        int result =obj.sumArray(arr);\n        System.out.println(\"Sum of Array elements are \"+result);\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
