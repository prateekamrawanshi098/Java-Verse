    {
      "id": "ptHgTqDlq_oIfREaOesg9",
      "type": "text",
      "x": 121,
      "y": 1609,
      "width": 1053,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
