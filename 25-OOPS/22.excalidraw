      "isDeleted": false,
      "boundElements": null,
      "updated": 1785485030257,
      "link": null,
      "locked": false,
      "text": "here a nd b will be allocated in memory when \nobject of Demo will be created .\nNumber of pairs of a nd will be = number of \nobjects\n\nthats the reason we call them instance variable as \nthey belong to instance .",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "here a nd b will be allocated in memory when \nobject of Demo will be created .\nNumber of pairs of a nd will be = number of \nobjects\n\nthats the reason we call them instance variable as \nthey belong to instance .",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mzkd2jOcy4HPxDdqg-n-1",
      "type": "text",
      "x": 270.3048288488652,
      "y": 1999.4390205498526,
      "width": 537,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
