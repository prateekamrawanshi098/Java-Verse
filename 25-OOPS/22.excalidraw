      "text": "class UseDemo{\n\npsvm {\n \n     Demo obj1 = new Demo ( )  ;\n     Demo obj2 = new Demo ( )  ;\n     Demo obj3 = new Demo ( )  ;\n\n     obj1.a = 10;\n     obj2.a = 20;\n     obj3.a = 30;\n\n \n     sout(\"obj1.a\");   //10\n     sout(\"obj2.a\");   //20\n     sout(\"obj3.a\");   //30\n\n     obj1.b = 10;\n     obj2.b = 20;\n     obj3.b = 30;\n\n \n     sout(\"obj1.b\");   //30\n     sout(\"obj2.b\");   //30\n     sout(\"obj3.b\");   //30\n\n\n      }\n\n\n}",
