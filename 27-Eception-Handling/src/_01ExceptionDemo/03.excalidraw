      "link": null,
      "locked": false,
      "text": "getMessage() : It is a method of Throwable which return string\nwith a message for the reason/cause of the exception .\n\ntoString() : This method belongs to Object class .\nIt is defined in such a way whenever we pass ref to print() it\nreturns hashcode of that object .\n\nSo java strongly recommends us to override the toString() so\nthat it return the object data in the form of string .",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "getMessage() : It is a method of Throwable which return string with a message for the reason/cause of the exception .\n\ntoString() : This method belongs to Object class .\nIt is defined in such a way whenever we pass ref to print() it returns hashcode of that object .\n\nSo java strongly recommends us to override the toString() so that it return the object data in the form of string .",
      "autoResize": false,
      "lineHeight": 1.25
    }
