      "link": null,
      "locked": false,
      "text": "How to store character in java\n============================                      \nchar grade= A;//error\nchar grade ='A';=>character literal or character\nconstant \n\njava follows unicode instead of ASCI table\nwhich ranges 0 to 65535.\n\nas java supports 61 languages\n\nand thus it consume 2B for each character",
      "fontSize": 19.03999999999999,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How to store character in java\n============================                                    \nchar grade= A;//error\nchar grade ='A';=>character literal or character constant \n\njava follows unicode instead of ASCI table\nwhich ranges 0 to 65535.\n\nas java supports 61 languages\n\nand thus it consume 2B for each character",
      "autoResize": false,
      "lineHeight": 1.25
    },
