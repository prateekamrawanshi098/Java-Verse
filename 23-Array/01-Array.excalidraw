    {
      "id": "BTJjzwC_BwpryUv2nAl8m",
      "type": "text",
      "x": 301,
      "y": 186,
      "width": 525,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
