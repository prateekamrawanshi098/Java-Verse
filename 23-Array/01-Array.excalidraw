      "isDeleted": false,
      "boundElements": [],
      "updated": 1782094909562,
      "link": null,
      "locked": false,
      "text": "Syntax\n=======\n\n1.Declaring Array\n_____________\n\n<data_type> [] <ref_name>;\n\nor \n\n<data_type> <ref_name> [];\n\n2.Creating actual Array\n___________________\n\n<ref_name>=new <data_type> [size];\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Syntax\n=======\n\n1.Declaring Array\n_____________\n\n<data_type> [] <ref_name>;\n\nor \n\n<data_type> <ref_name> [];\n\n2.Creating actual Array\n___________________\n\n<ref_name>=new <data_type> [size];\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
