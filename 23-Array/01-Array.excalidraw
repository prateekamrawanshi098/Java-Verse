    {
      "id": "_lkPmhrvL5F1GX1L67MY2",
      "type": "text",
      "x": 318.3139777642295,
      "y": 2387.4362608867987,
      "width": 522,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ap",
      "roundness": null,
      "seed": 2040073570,
      "version": 320,
      "versionNonce": 1249040894,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782098384217,
      "link": null,
      "locked": false,
      "text": "int [] arr=new int [10];\n\narr[0]=10;\narr[1]=20;\n\nSOP(arr); // it is not an error but will print hashcode\n\nSOP(arr[0]); // 10\nSOP(arr[1]); // 20\nSOP(arr[6]); // ArrayIndexOutOfBoundException ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int [] arr=new int [10];\n\narr[0]=10;\narr[1]=20;\n\nSOP(arr); // it is not an error but will print hashcode\n\nSOP(arr[0]); // 10\nSOP(arr[1]); // 20\nSOP(arr[6]); // ArrayIndexOutOfBoundException ",
      "autoResize": true,
      "lineHeight": 1.25
    },
