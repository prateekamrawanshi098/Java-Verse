      "isDeleted": false,
      "boundElements": [],
      "updated": 1782182682032,
      "link": null,
      "locked": false,
      "text": "Jagged 2-D Array\n=================\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Jagged 2-D Array\n=================\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XqeCZ2hMvzf0LJTu7eQ64",
      "type": "text",
      "x": 437.18378243323946,
      "y": 3028.6989507932353,
      "width": 672.1540871302642,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 638186213,
      "version": 370,
      "versionNonce": 1720100427,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782182933669,
      "link": null,
      "locked": false,
      "text": "Syntax\n======\n\ncreating Array reference\n======================\n\n<data_type> [][] <ref_name>=new <data_type>[row_size][];\n\ncreating actual Array\n===================\n\n<ref_name>[row index]=new <data_type>[size];\n<ref_name>[row index]=new <data_type>[size];\n<ref_name>[row index]=new <data_type>[size];\n..........................\n..............\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Syntax\n======\n\ncreating Array reference\n======================\n\n<data_type> [][] <ref_name>=new <data_type>[row_size][];\n\ncreating actual Array\n===================\n\n<ref_name>[row index]=new <data_type>[size];\n<ref_name>[row index]=new <data_type>[size];\n<ref_name>[row index]=new <data_type>[size];\n..........................\n..............\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "fzySDK_orfkSNaPw6i1Jn",
      "type": "text",
