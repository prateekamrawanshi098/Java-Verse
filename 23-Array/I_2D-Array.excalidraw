      "seed": 140833419,
      "version": 75,
      "versionNonce": 2061995365,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782180749127,
      "link": null,
      "locked": false,
      "text": "Access\n==========\n\narr[0]=25; //Error\n\narr[0][0]=20;\n\narr[0][1]=30;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Access\n==========\n\narr[0]=25; //Error\n\narr[0][0]=20;\n\narr[0][1]=30;",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fzBtf-ONHCuTqFJdvuBhE",
      "type": "text",
      "x": 402.2292770663785,
      "y": 2074.1720734674195,
      "width": 509,
      "height": 725,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 1814358917,
      "version": 451,
      "versionNonce": 982303115,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782182327647,
      "link": null,
      "locked": false,
      "text": "Initializing 2D Array\n===================\n\n1.\n\nint [] [] arr=new int [2][3];\narr[0][1]=20;\narr[1][2]=30;\n...................\n....\n\n\n2.\n\nint [] [] arr = new int [] [] {{10,20,30}{50,60,70}};\n\n3.\n\nint [] [] arr  = {{10,20,30},{40,50,60}};\n\n4.\n\nint [] [] arr ;\narr={{10,20,30},{40,50,60}};  // Error\n\n5.\n\nint [] [] arr ;\narr=new int [] [] {{10,20,30},{40,50,60}};",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Initializing 2D Array\n===================\n\n1.\n\nint [] [] arr=new int [2][3];\narr[0][1]=20;\narr[1][2]=30;\n...................\n....\n\n\n2.\n\nint [] [] arr = new int [] [] {{10,20,30}{50,60,70}};\n\n3.\n\nint [] [] arr  = {{10,20,30},{40,50,60}};\n\n4.\n\nint [] [] arr ;\narr={{10,20,30},{40,50,60}};  // Error\n\n5.\n\nint [] [] arr ;\narr=new int [] [] {{10,20,30},{40,50,60}};",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9f6Lto2j0GbI4pe1jGODQ",
      "type": "text",
      "x": 676.4877037909799,
      "y": 2930.5574549555104,
      "width": 187,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
