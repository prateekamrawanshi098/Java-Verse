    {
      "id": "Pnjkfzbc1TAxmVDRHOwPz",
      "type": "text",
      "x": 373,
      "y": 693,
      "width": 263,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
