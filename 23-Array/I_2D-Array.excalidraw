      "link": null,
      "locked": false,
      "text": "int [] [] arr = new int [3] [] ;\n\narr[0]=new int [4];\n\narr[0]=new int [2];\n\narr[0]=new int [3];",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int [] [] arr = new int [3] [] ;\n\narr[0]=new int [4];\n\narr[0]=new int [2];\n\narr[0]=new int [3];",
