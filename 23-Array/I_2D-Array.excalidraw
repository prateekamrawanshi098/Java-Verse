      "isDeleted": false,
      "boundElements": [],
      "updated": 1782141042960,
      "link": null,
      "locked": false,
      "text": "1. Creating Array reference\n\n<data_type>[][] <ref>;\n\nor\n\n<data_type><ref>[][];\n\nor\n\n<data_type>[]<ref>[];",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Creating Array reference\n\n<data_type>[][] <ref>;\n\nor\n\n<data_type><ref>[][];\n\nor\n\n<data_type>[]<ref>[];",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TBK1p1-Z5wvcHoQdnTK-r",
      "type": "text",
      "x": 374,
      "y": 1027,
      "width": 829,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1826221124,
      "version": 401,
      "versionNonce": 1785279403,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782180654323,
      "link": null,
      "locked": false,
      "text": "2. creating 2D array object\n===========================\n\n<ref>=new <data_type> [row_size][col_size];\n\n\n\n\n\n\n\n\nCreating Rectangular Array\n=========================\n\nint [][]arr;                          arr is an array of refremces to an array of integers.\narr=new int [3][4];\n\n                             ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. creating 2D array object\n===========================\n\n<ref>=new <data_type> [row_size][col_size];\n\n\n\n\n\n\n\n\nCreating Rectangular Array\n=========================\n\nint [][]arr;                          arr is an array of refremces to an array of integers.\narr=new int [3][4];\n\n                             ",
      "autoResize": true,
      "lineHeight": 1.25
    },
